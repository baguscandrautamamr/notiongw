# --- Supabase ---
# Project URL and publishable (anon) key. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://kpcimwmnyivtehroscyd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_X9Uz_tcuVRMKiQux7xJjvQ_F_exgoUu

# Service role key — SECRET, server only. Needed by the deadline-reminder cron
# (/api/cron/reminders) to read tasks across users. Supabase Dashboard →
# Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Secret protecting the cron endpoint. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>". Use any long random string.
CRON_SECRET=your_random_cron_secret

# --- Cloudinary (unsigned upload) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=spzbee49
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default

# --- Web Push (VAPID) ---
# Generate a pair with:  npm run gen:vapid
# The PUBLIC key is exposed to the browser; keep the PRIVATE key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
